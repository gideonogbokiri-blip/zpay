# Local development can use the mock API.
EXPO_PUBLIC_USE_MOCK=true
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Only enable this when manually testing OTP flows with the mock API.
EXPO_PUBLIC_DEBUG_OTP=false

# Production builds must use the real HTTPS backend.
# EXPO_PUBLIC_USE_MOCK=false
# EXPO_PUBLIC_API_URL=https://zpay-backend.onrender.com/api
