{
  "name": "zpay",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.85.0",
    "expo": "~57.0.14",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.12",
    "expo-crypto": "^57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-modules-core": "~57.0.11",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.61.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild",
    "check:release-env": "node scripts/check-release-env.js",
    "check:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-zpay-assets.ps1",
    "generate:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-zpay-assets.ps1",
    "build:android": "npm run check:release-env && npx eas-cli build --platform android --profile production",
    "build:android:apk": "npm run check:release-env && npx eas-cli build --platform android --profile preview",
    "build:ios": "npm run check:release-env && npx eas-cli build --platform ios --profile production",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts",
      "<rootDir>/__tests__/**/*.test.tsx"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/jest.styleMock.js"
    }
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
